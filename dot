#!/usr/bin/env zsh
set -euo pipefail

DIR="${0:A:h}"
VERBOSE=0

# renovate: datasource=github-tags depName=junegunn/vim-plug
VIM_PLUG_VERSION=0.15.0

# _has_color [fd]
# Succeeds when fd (default 1) is a terminal and NO_COLOR is unset.
_has_color() {
    [[ -t ${1:-1} && -z "${NO_COLOR:-}" ]]
}

# _has_gum
# Succeeds when styled output via gum is available. gum is optional: it is not
# installed until the Brewfile runs, so every helper has a plain fallback.
_has_gum() {
    _has_color && command -v gum &>/dev/null
}

# _tilde <string>
# Replaces the home directory with ~ and the dotfiles directory with a relative path.
_tilde() {
    local s=${1//$DIR\//}
    print -r -- "${s//$HOME/~}"
}

# _log <message...>
# Prints a section header to stdout.
_log() {
    if _has_gum; then
        print
        gum style --foreground 67 --bold "▍ $*"
        print
    else
        print "\n$(tput bold)$*$(tput sgr0)\n"
    fi
}

# _status <kind> <detail...>
# Prints a one-line status: marker, kind, then a dimmed detail.
# kind is one of linked, merged, updated, ok, removed, skipped, warn.
_status() {
    local kind=$1 marker color detail; shift
    detail=$(_tilde "$*")

    case $kind in
        linked|merged|updated|ok) marker="✓" color=108 ;;
        removed)                  marker="–" color=67 ;;
        skipped|warn)             marker="!" color=179 ;;
        *)                        marker="•" color=244 ;;
    esac

    if _has_color; then
        printf '\e[38;5;%sm%s\e[0m %-8s \e[38;5;244m%s\e[0m\n' "$color" "$marker" "$kind" "$detail"
    else
        printf '%-8s %s\n' "$kind" "$detail"
    fi
}

# _hyperlink <url> <text>
# Sets REPLY to a clickable link (plain text without a tty or url).
_hyperlink() {
    local url=$1 text=$2
    if [[ -n "$url" ]] && _has_color; then
        REPLY=$'\e]8;;'"$url"$'\e\\'"$text"$'\e]8;;\e\\'
    else
        REPLY=$text
    fi
}

# _repo_url
# Prints origin's GitHub URL, if any.
_repo_url() {
    local url
    url=$(git -C "$DIR" remote get-url origin 2>/dev/null) || return 0
    url=${url%.git}
    url=${url/#git@github.com:/https://github.com/}
    url=${url/#ssh:\/\/git@github.com\//https://github.com/}
    [[ "$url" == https://github.com/* ]] && print -r -- "$url"
    return 0
}

# _err <message...>
# Prints an error to stderr.
_err() {
    if _has_color 2; then
        printf '\e[38;5;167m✗\e[0m %s\n' "$*" >&2
    else
        print -r -- "$*" >&2
    fi
}

# _spin <title> <command...>
# Runs an external command behind a spinner, showing its output only on failure.
# Without gum, or with --verbose, runs it directly. Reports ok afterwards either way.
_spin() {
    local title=$1; shift
    if _has_gum && (( ! VERBOSE )); then
        gum spin --spinner dot --title "$title" --show-error -- "$@"
    else
        "$@"
        if (( VERBOSE )); then print; fi
    fi
    _status ok "$title"
}

# _symlink <source> <link>
# Symlinks source to link, replacing any existing link, and reports it.
_symlink() {
    local src=$1 link=$2
    ln -sf "$src" "$link"
    [[ -d "$link" && ! -L "$link" ]] && link="$link/${src:t}"
    _status linked "$link → $src"
}

# _require <command>
# Exits with an error if command is not installed.
_require() {
    if ! command -v "$1" &>/dev/null; then
        _err "Error: '$1' is required but not installed."
        exit 1
    fi
}

# _ensure <path> [mode]
# Creates a file (or a directory, if path ends in /) with an optional permission mode.
_ensure() {
    local target=$1 mode=${2:-}

    if [[ "$target" == */ ]]; then
        mkdir -p "$target"
    else
        mkdir -p "${target:h}"
        [[ -e "$target" ]] || touch "$target"
    fi

    if [[ -n "$mode" ]]; then chmod "$mode" "$target"; fi
}

# _resolve_getpath
# Returns the dotfiles root path from GETPATH, git config, or the default ~/src.
_resolve_getpath() {
    local getpath=${GETPATH:-$(git config --global get.path 2>/dev/null || true)}
    print -r -- "${getpath:-~/src}"
}

# _dotfiles_path
# Prints the absolute path where `init` clones the dotfiles.
_dotfiles_path() {
    local getpath=$(_resolve_getpath)
    getpath=${getpath/#\~/$HOME}
    print -r -- "${getpath%/}/github.com/arbourd/dotfiles"
}

# _warn_location
# Warns when dot runs from a checkout other than the one `init` manages.
_warn_location() {
    local expected=$(_dotfiles_path)
    [[ "$DIR" == "${expected:A}" ]] || _status warn "running from $DIR, not $expected"
}

# _remove_stale_link <link> <prefix>
# Removes link if it points to a missing target within prefix.
_remove_stale_link() {
    local link=$1 prefix=$2 target
    [[ -L "$link" ]] || return 0

    target=$(readlink "$link")
    [[ "$target" == "$prefix"* && ! -e "$target" ]] || return 0

    unlink "$link"
    _status removed "$link"
}

# _clean_dir <prefix> <dir...>
# Removes stale symlinks in each dir that resolve within prefix.
_clean_dir() {
    local prefix=$1 dir link removed=0; shift
    for dir in "$@"; do
        for link in "$dir"/*(DN@); do
            _remove_stale_link "$link" "$prefix"
            [[ -L "$link" ]] || removed=1
        done
    done
    (( removed )) || _status ok "none found"
}

# _json_patch <live file> <repo file>
# Prints the repo file merged over the live one: json() reads JSONC, CAST stops it reading the file as JSONB,
# and a missing or blank live file counts as {}. json_patch (RFC 7396) deep-merges with repo winning, like _merge_orca_settings.
# .agents/skills/claude-settings-audit/scripts/compare.js runs the same SQL; keep them in step.
_json_patch() {
    local live=${1//\'/\'\'} repo=${2//\'/\'\'}
    sqlite3 :memory: "SELECT json_patch(
        json(coalesce(nullif(trim(CAST(readfile('$live') AS TEXT), ' '||char(9,10,13)), ''), '{}')),
        json(CAST(readfile('$repo') AS TEXT)))"
}

# _merge_claude_settings
# Merges agents/claude/settings.jsonc into ~/.claude/settings.json and agents/claude/config.jsonc into ~/.claude.json.
# Claude Code reads global config keys only from ~/.claude.json, which it also writes itself.
_merge_claude_settings() {
    _require sqlite3
    _ensure ~/.claude/

    local -a names=(settings.jsonc config.jsonc) lives=(~/.claude/settings.json ~/.claude.json) merged
    local i tmp
    # Merge both before writing either, so a missing or invalid file leaves both untouched.
    for i in 1 2; do
        merged[i]=$(_json_patch "${lives[i]}" "$DIR/agents/claude/${names[i]}")
        [[ -n ${merged[i]} ]] || { _err "Error: claude merge produced nothing (${names[i]} missing?)"; exit 1; }
    done

    for i in 1 2; do
        tmp=$(mktemp)
        print -r -- "${merged[i]}" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "${lives[i]}" \
            || { rm -f "$tmp"; return 1; }
        _status merged "$DIR/agents/claude/${names[i]} → ${lives[i]}"
    done
}

# _merge_codex_config
# Merges agents/codex/config.toml into ~/.codex/config.toml.
_merge_codex_config() {
    _require yq
    _ensure ~/.codex/config.toml

    local tmp=$(mktemp)
    yq -p toml -o toml eval-all '. as $i ireduce({}; . * $i)' ~/.codex/config.toml "$DIR/agents/codex/config.toml" > "$tmp" || { rm -f "$tmp"; return 1; }
    mv "$tmp" ~/.codex/config.toml
    chmod 600 ~/.codex/config.toml

    _status merged "$DIR/agents/codex/config.toml → $HOME/.codex/config.toml"
}

# _merge_orca_settings
# Merges orca/settings.jsonc into Orca's profile db and updates its content_hash.
_merge_orca_settings() {
    local db="$HOME/Library/Application Support/orca/profiles/local-default/profile-state.db"

    if [[ ! -f "$db" ]]; then
        _status skipped "orca settings: $db not found"
        return 0
    fi

    _require sqlite3

    if [[ "${TERM_PROGRAM:-}" == Orca ]]; then
        _status skipped "orca settings: run from a terminal outside Orca"
        return 0
    fi

    if pgrep -x Orca >/dev/null; then
        _status skipped "orca settings: quit Orca and rerun"
        return 0
    fi

    # RFC 7396 merge patch: nested objects merge, null deletes a key.
    # Doubling ' escapes it inside the SQL string literal.
    local file=${DIR//\'/\'\'}/orca/settings.jsonc
    local new="json_patch(payload, json(CAST(readfile('$file') AS TEXT)))" payload hash
    payload=$(sqlite3 "$db" "SELECT $new FROM profile_state_documents WHERE domain='settings'")
    [[ -n $payload ]] || { _err "Error: orca settings merge produced no payload (settings.jsonc missing, or no settings row)"; exit 1; }
    hash=$(print -rn -- "$payload" | shasum -a 256 | cut -d' ' -f1)
    sqlite3 "$db" "UPDATE profile_state_documents SET payload = $new, content_hash = '$hash' WHERE domain='settings'"

    _status merged "orca settings → $db"
}

# _merge_rex_settings
# Runs rex/settings.zsh to write the pinned Rex.app preferences.
_merge_rex_settings() {
    local domain=com.superlogical.rex

    if ! defaults read $domain &>/dev/null; then
        _status skipped "rex settings: no preferences yet, launch Rex once and rerun"
        return 0
    fi

    "$DIR/rex/settings.zsh"

    _status merged "rex settings → $domain"
}

# _link_agents
# Symlinks agent skills, personas, and global instructions into all supported AI tool directories.
_link_agents() {
    local claude persona skill
    _ensure ~/.claude/
    for claude in "$DIR/agents/claude"/*(N); do
        [[ "${claude:t}" == (settings|config).jsonc ]] && continue
        _symlink "$claude" ~/.claude
    done

    _ensure ~/.claude/agents/
    _ensure ~/.gemini/agents/
    _ensure ~/.config/opencode/agents/
    _ensure ~/.pi/agent/prompts/

    for persona in "$DIR/agents/personas"/*.md(N); do
        _symlink "$persona" ~/.claude/agents
        _symlink "$persona" ~/.gemini/agents
        _symlink "$persona" ~/.config/opencode/agents
        _symlink "$persona" ~/.pi/agent/prompts
    done

    _ensure ~/.claude/skills/
    _ensure ~/.agents/skills/

    for skill in "$DIR/agents/skills"/*(/N); do
        _symlink "$skill" ~/.claude/skills
        _symlink "$skill" ~/.agents/skills
    done

    # global instructions, shared across every tool.
    _ensure ~/.codex/
    _symlink "$DIR/agents/AGENTS.md" ~/.claude/AGENTS.md
    _symlink "$DIR/agents/AGENTS.md" ~/.gemini/GEMINI.md
    _symlink "$DIR/agents/AGENTS.md" ~/.codex/AGENTS.md
    _symlink "$DIR/agents/AGENTS.md" ~/.pi/agent/AGENTS.md
}

# _run <install|merge> <step-function> [target...]
# Calls the step function with each target in order, or all of the command's targets without one.
_run() {
    local cmd=$1 step=$2 target entry; shift 2
    local -a targets=("$@")
    # branch on the count, so an empty target is rejected rather than run-all
    if (( $# )); then
        _check_targets "$cmd" "$@"
    else
        for entry in ${(f)"$(_targets "$cmd")"}; do targets+=(${entry%%:*}); done
    fi

    for target in $targets; do
        $step $target
    done
}

# _merge_step <claude|codex|orca|rex>
_merge_step() {
    case $1 in
        claude) _merge_claude_settings ;;
        codex) _merge_codex_config ;;
        orca) _merge_orca_settings ;;
        rex) _merge_rex_settings ;;
        *) _err "error: no handler for merge target: \"$1\""; exit 1 ;;
    esac
}

# _merge [claude|codex|orca|rex]...
# Merges repo settings into the given live tool configs, or all four without a target.
_merge() {
    (( $# )) || _log "Merging settings"
    _run merge _merge_step "$@"
}

# _clean
# Removes stale dotfile and agent symlinks from home directories.
_clean() {
    _log "Cleaning stale dotfile symlinks"
    _clean_dir "$DIR/" ~ ~/.config/fish ~/.config/fish/completions ~/.config/fish/functions ~/.config/ghostty ~/.config/git ~/.config/zed ~/.gnupg ~/.local/bin ~/.local/share/bash-completion/completions ~/.orca ~/.ssh ~/.vim ~/.zsh/completions

    _log "Cleaning stale agent dotfile symlinks"
    _clean_dir "$DIR/agents/" ~/.claude ~/.claude/skills ~/.agents/skills ~/.claude/agents ~/.gemini ~/.gemini/agents ~/.config/opencode/agents ~/.pi/agent ~/.pi/agent/prompts ~/.codex
}

# _usage
# Prints usage information to stdout.
_usage() {
    print -r -- "Usage: dot [-v|--verbose] [COMMAND]
Commands:
  help              prints this dialog
  init              clones dotfiles to GETPATH (~/src) and symlinks dot to ~/.local/bin
  install [TARGET]  installs all packages (or any of: brew|defaults|fisher|vim)
  link              symlinks dotfiles and removes stale symlinks
  merge [TARGET]    merges settings into claude, codex, orca and rex (or any of: claude|codex|orca|rex)
  update            updates the dotfiles repository
  version           prints the current commit sha
Options:
  -v, --verbose     shows full output instead of spinners
  -h, --help        prints usage for a command or target (e.g. install brew)
"
}

# _targets <install|merge>
# Prints the command's targets as "target:description" lines.
_targets() {
    case $1 in
        install)
            print -l \
                "brew:installs homebrew packages" \
                "defaults:installs macos defaults" \
                "fisher:installs fisher packages" \
                "vim:installs vim packages"
            ;;
        merge)
            print -l \
                "claude:merges agents/claude/settings.jsonc into ~/.claude/settings.json and config.jsonc into ~/.claude.json" \
                "codex:merges agents/codex/config.toml into ~/.codex/config.toml" \
                "orca:merges orca/settings.jsonc into Orca's profile db" \
                "rex:writes pinned Rex.app preferences with defaults write"
            ;;
    esac
}

# _target_desc <install|merge> <target>
# Prints the target's description. Fails when the command has no such target.
_target_desc() {
    local entry
    for entry in ${(f)"$(_targets "$1")"}; do
        if [[ "${entry%%:*}" == "$2" ]]; then
            print -r -- "${entry#*:}"
            return 0
        fi
    done
    return 1
}

# _unknown_target <install|merge> <target>
# Reports an unknown target with the command's usage, and exits 1.
_unknown_target() {
    _err "error: unknown $1 target: \"$2\""
    _usage_cmd "$1" >&2
    exit 1
}

# _check_targets <install|merge> <target>...
# Exits 1 on the first target that isn't one of the command's, before anything runs.
_check_targets() {
    local cmd=$1 target; shift
    for target in "$@"; do
        _target_desc "$cmd" "$target" >/dev/null || _unknown_target "$cmd" "$target"
    done
}

# _usage_target <install|merge> <target>
# Prints usage for one target. Exits 1 on an unknown target.
_usage_target() {
    local desc
    desc=$(_target_desc "$1" "$2") || _unknown_target "$1" "$2"
    print -r -- "Usage: dot $1 $2"
    print -r -- "$desc"
}

# _usage_cmd <install|merge> [target]
# Prints usage for a command and its targets, or for one target if given.
_usage_cmd() {
    local cmd=$1 summary entry name width=0

    # a target was given, even if empty
    if (( $# > 1 )); then
        _usage_target "$cmd" "$2"
        return
    fi

    case $cmd in
        install) summary="installs all packages in order, or just the targets given" ;;
        merge) summary="merges settings into claude, codex, orca and rex, or just the targets given" ;;
    esac

    local -a entries=(${(f)"$(_targets "$cmd")"})
    for entry in $entries; do
        name=${entry%%:*}
        (( ${#name} > width )) && width=${#name}
    done

    print -r -- "Usage: dot $cmd [TARGET]"
    print -r -- "$summary"
    print -r -- "Targets:"
    for entry in $entries; do
        printf "  %-${width}s  %s\n" "${entry%%:*}" "${entry#*:}"
    done
}

# _version
# Prints the current commit SHA of the dotfiles repository.
_version() {
    _require git

    local sha repo
    sha=$(git -C "$DIR" rev-parse --short HEAD)
    repo=$(_repo_url)

    _hyperlink "${repo:+$repo/commit/$sha}" "$sha"
    print -r -- "$REPLY"
}

# _init
# Clones the dotfiles repository to GETPATH and symlinks dot to ~/.local/bin.
_init() {
    _require git

    local target=$(_dotfiles_path)

    local -a gitv=()
    (( VERBOSE )) && gitv=(-v)

    _log "Initializing dotfiles"

    if [[ -d "$target" ]]; then
        _status ok "$target already exists, pulling"
        _spin "pulling dotfiles" git -C "$target" pull "${gitv[@]}"
    else
        _ensure "${target:h}/"
        _spin "cloning dotfiles" git clone "${gitv[@]}" https://github.com/arbourd/dotfiles.git "$target"
    fi

    _ensure ~/.local/bin/
    _symlink "$target/dot" ~/.local/bin/dot
}

# _update
# Pulls the latest dotfiles changes and reports the old and new commit SHA.
_update() {
    _require git

    local before after repo
    before=$(git -C "$DIR" rev-parse --short HEAD)
    local -a pullv=(--quiet)
    (( VERBOSE )) && pullv=(-v)
    _spin "pulling dotfiles" git -C "$DIR" pull "${pullv[@]}"
    after=$(git -C "$DIR" rev-parse --short HEAD)
    repo=$(_repo_url)

    if [[ "$before" == "$after" ]]; then
        _hyperlink "${repo:+$repo/commit/$after}" "$after"
        _status ok "dotfiles $REPLY (up to date)"
    else
        _hyperlink "${repo:+$repo/compare/$before...$after}" "$before → $after"
        _status updated "dotfiles $REPLY"
    fi
}

# _link
# Symlinks all dotfiles into home and removes stale symlinks.
_link() {
    local fn
    _log "Symlinking dotfiles"

    # bash, fish and zsh
    _ensure ~/.config/fish/private.fish 600

    _symlink "$DIR/sh/.shrc" ~/.bash_profile
    _symlink "$DIR/sh/.shrc" ~/.bashrc
    _symlink "$DIR/sh/.shrc" ~/.zshrc

    _symlink "$DIR/sh/config.fish" ~/.config/fish/config.fish
    _symlink "$DIR/sh/fish_plugins" ~/.config/fish/fish_plugins

    # fish functions
    _ensure ~/.config/fish/functions/
    for fn in "$DIR/sh/functions"/*.fish(N); do
        _symlink "$fn" ~/.config/fish/functions
    done

    # completions
    _ensure ~/.config/fish/completions/
    _symlink "$DIR/sh/completions/dot.fish" ~/.config/fish/completions/dot.fish

    _ensure ~/.local/share/bash-completion/completions/
    _symlink "$DIR/sh/completions/dot.bash" ~/.local/share/bash-completion/completions/dot

    _ensure ~/.zsh/completions/
    _symlink "$DIR/sh/completions/_dot" ~/.zsh/completions/_dot

    # ghostty
    _ensure ~/.config/ghostty/
    _symlink "$DIR/ghostty/config" ~/.config/ghostty/config

    # git
    _ensure ~/.config/git/private 600
    _symlink "$DIR/git/config" ~/.config/git/config
    _symlink "$DIR/git/gitignore" ~/.config/git/gitignore

    # gpg
    _ensure ~/.gnupg/ 700
    _symlink "$DIR/gpg/gpg-agent.conf" ~/.gnupg/gpg-agent.conf

    # orca
    _ensure ~/.orca/
    _symlink "$DIR/orca/keybindings.json" ~/.orca/keybindings.json

    # ssh
    _ensure ~/.ssh/
    _symlink "$DIR/ssh/config" ~/.ssh/config

    # vim
    _ensure ~/.vim/
    _symlink "$DIR/vim/vimrc" ~/.vim/vimrc

    # zed
    _ensure ~/.config/zed/
    _symlink "$DIR/zed/settings.json" ~/.config/zed/settings.json

    _log "Symlinking agent dotfiles"
    _link_agents

    _clean

    _log "Run dot merge to merge settings"
}

# _install_defaults
# Applies macOS defaults settings.
_install_defaults() {
    _log "macOS defaults"
    _spin "macos defaults" "$DIR/.macOS"
}

# _install_brew
# Installs Homebrew if missing and installs packages from the Brewfile.
_install_brew() {
    _require curl

    _log "Homebrew"
    if ! command -v brew &>/dev/null; then
        # pinned to a Homebrew/install commit, which Renovate updates
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/6cb910c93f8194b1661a490278a488482399d380/install.sh)"
    fi
    _status ok "homebrew installed"

    _spin "homebrew packages" env HOMEBREW_BUNDLE_NO_LOCK=1 brew bundle --file "$DIR/Brewfile"
}

# _install_fisher
# Installs Fisher and updates all fish plugins.
_install_fisher() {
    _require brew
    _require curl
    _require git

    _log "Fisher"
    if ! command -v fish &>/dev/null; then
        _spin "fish" brew install fish
    fi

    if [[ ! -e ~/.config/fish/fish_plugins ]]; then
        _err "Error: ~/.config/fish/fish_plugins not found; run 'dot link' first."
        exit 1
    fi

    _ensure ~/.config/fish/functions/
    # fisher's version is pinned in fish_plugins; `fisher install` would conflict with an existing fisher
    git -C "$DIR" checkout sh/fish_plugins
    local version
    version=${$(grep -o 'jorgebucaran/fisher@.*' "$DIR/sh/fish_plugins")#*@}
    _spin "fisher plugins" fish -c "curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/$version/functions/fisher.fish | source && fisher update"
}

# _install_vim
# Installs vim-plug and updates all Vim plugins.
_install_vim() {
    _require vim
    _require curl

    _log "Vim"
    if [[ ! -e ~/.vim/vimrc ]]; then
        _err "Error: ~/.vim/vimrc not found; run 'dot link' first."
        exit 1
    fi

    _ensure ~/.vim/autoload/
    _spin "vim-plug" curl -fsSLo ~/.vim/autoload/plug.vim --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/$VIM_PLUG_VERSION/plug.vim

    # pipe two newlines to dismiss vim-plug prompts without a tty
    # vim's output is only shown on failure or with --verbose
    _spin "vim plugins" zsh -c 'log=$(mktemp); echo | echo | vim +PlugUpdate +PlugClean! +qall &>$log; rc=$?; (( rc || $1 )) && cat $log; rm -f $log; exit $rc' _ "$VERBOSE"
}

# _install_step <brew|defaults|fisher|vim>
_install_step() {
    "_install_$1"
}

# _install [brew|defaults|fisher|vim]...
# Runs the given install steps in order, or all of them (brew, defaults, fisher, vim) without a target.
_install() {
    _run install _install_step "$@"
}

# _help [command [target]]
# Prints usage for a command or target, like `dot <command> --help`.
_help() {
    if (( ! $# )); then
        _usage
        return
    fi

    case $1 in
        install|merge) _usage_cmd "$@" ;;
        help|init|link|update|version) _usage ;;
        *)
            _err "error: unknown command: \"$1\""
            _usage >&2
            exit 1
            ;;
    esac
}

# Only dispatch when executed. ZSH_EVAL_CONTEXT contains ":file" when sourced,
# which lets tests source this file to reach the functions above.
[[ "$ZSH_EVAL_CONTEXT" == *:file* ]] && return 0

args=()
for arg in "$@"; do
    case $arg in
        -v|--verbose) VERBOSE=1 ;;
        # `dot X --help` is `dot help X`, once
        -h|--help) [[ "${args[1]:-}" == help ]] || args=(help "${args[@]}") ;;
        *) args+=("$arg") ;;
    esac
done
set -- "${args[@]}"

case ${1:-} in
    help)
        _help "${@:2}"
        exit 0
        ;;
    init)
        _init
        ;;
    link)
        _warn_location
        _link
        ;;
    merge)
        _warn_location
        _merge "${@:2}"
        ;;
    install)
        _warn_location
        _install "${@:2}"
        ;;
    update)
        _warn_location
        _update
        ;;
    version)
        _version
        ;;
    "")
        _err "error: command required"
        _usage >&2
        exit 1
        ;;
    *)
        _err "error: unknown command: \"$1\""
        _usage >&2
        exit 1
        ;;
esac
