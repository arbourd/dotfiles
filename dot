#!/usr/bin/env zsh
set -euo pipefail

DIR="${0:A:h}"

# _has_color [fd]
# Succeeds when fd (default 1) is a terminal and NO_COLOR is unset.
_has_color() {
    [[ -t ${1:-1} && -z "${NO_COLOR:-}" ]]
}

# _has_gum
# Succeeds when styled output via gum is available. gum is optional: it is not
# installed until the Brewfile runs, so every helper has a plain fallback.
_has_gum() {
    _has_color && command -v gum &> /dev/null
}

# _tilde <string>
# Replaces the home directory with ~ and the dotfiles directory with a relative path.
_tilde() {
    local s=${1//$DIR\//}
    print -r -- "${s//$HOME/~}"
}

# _log <message...>
# Prints a section header to stdout.
_log() {
    if _has_gum; then
        echo
        gum style --foreground 67 --bold "▍ $*"
        echo
    else
        echo "\n$(tput bold)$*$(tput sgr0)\n"
    fi
}

# _status <kind> <detail...>
# Prints a one-line status: marker, kind, then a dimmed detail.
# kind is one of linked, merged, updated, ok, removed, skipped.
_status() {
    local kind=$1 marker color detail; shift
    detail=$(_tilde "$*")

    case $kind in
        linked|merged|updated|ok) marker="✓" color=108 ;;
        removed)                  marker="–" color=67 ;;
        skipped)                  marker="!" color=179 ;;
        *)                        marker="•" color=244 ;;
    esac

    if _has_color; then
        printf '\e[38;5;%sm%s\e[0m %-8s \e[38;5;244m%s\e[0m\n' "$color" "$marker" "$kind" "$detail"
    else
        printf '%-8s %s\n' "$kind" "$detail"
    fi
}

# _hyperlink <url> <text>
# Sets REPLY to a clickable link (plain text without a tty or url).
_hyperlink() {
    local url=$1 text=$2
    if [[ -n "$url" ]] && _has_color; then
        REPLY=$'\e]8;;'"$url"$'\e\\'"$text"$'\e]8;;\e\\'
    else
        REPLY=$text
    fi
}

# _repo_url
# Prints origin's GitHub URL, if any.
_repo_url() {
    local url
    url=$(git -C "$DIR" remote get-url origin 2>/dev/null) || return 0
    url=${url%.git}
    url=${url/#git@github.com:/https://github.com/}
    url=${url/#ssh:\/\/git@github.com\//https://github.com/}
    [[ "$url" == https://github.com/* ]] && echo "$url"
    return 0
}

# _err <message...>
# Prints an error to stderr.
_err() {
    if _has_color 2; then
        printf '\e[38;5;167m✗\e[0m %s\n' "$*" >&2
    else
        echo "$*" >&2
    fi
}

# _spin <title> <command...>
# Runs an external command behind a spinner, showing its output only on failure.
# Falls back to printing the title and running the command directly.
_spin() {
    local title=$1; shift
    if _has_gum; then
        gum spin --spinner dot --title "$title" --show-error -- "$@"
        _status ok "$title"
    else
        echo "$title"
        "$@"
    fi
}

# _symlink <source> <link>
# Symlinks source to link, replacing any existing link, and reports it.
_symlink() {
    local src=$1 link=$2
    ln -sf "$src" "$link"
    [[ -d "$link" && ! -L "$link" ]] && link="$link/${src:t}"
    _status linked "$link → $src"
}

# _require <command>
# Exits with an error if command is not installed.
_require() {
    if ! command -v "$1" &> /dev/null; then
        _err "Error: '$1' is required but not installed."
        exit 1
    fi
}

# _ensure <path> [mode]
# Creates a file (or a directory, if path ends in /) with an optional permission mode.
_ensure() {
    local target=$1 mode=${2:-}

    if [[ "$target" == */ ]]; then
        mkdir -p "$target"
    else
        mkdir -p "${target:h}"
        [[ -e "$target" ]] || touch "$target"
    fi

    if [[ -n "$mode" ]]; then chmod "$mode" "$target"; fi
}

# _resolve_getpath
# Returns the dotfiles root path from GETPATH, git config, or the default ~/src.
_resolve_getpath() {
    local getpath="${GETPATH:-}"
    if [ -z "$getpath" ] && command -v git &>/dev/null; then
        getpath=$(git config --global get.path || echo "")
    fi
    if [ -z "$getpath" ]; then
        getpath="~/src"
    fi
    echo "$getpath"
}

# _remove_stale_link <link> <prefix>
# Removes link if it points to a missing target within prefix.
_remove_stale_link() {
    local link=$1 prefix=$2 target
    [ -L "$link" ] || return 0

    target=$(readlink "$link")
    [[ "$target" == "$prefix"* && ! -e "$target" ]] || return 0

    unlink "$link"
    _status removed "$link"
}

# _clean_dir <prefix> <dir...>
# Removes stale symlinks in each dir that resolve within prefix.
_clean_dir() {
    local prefix=$1 dir link; shift
    for dir in "$@"; do
        for link in "$dir"/*(DN@); do
            _remove_stale_link "$link" "$prefix"
        done
    done
}

# _merge_claude_settings
# Merges agents/claude/settings.json into ~/.claude/settings.json.
_merge_claude_settings() {
    _require jq
    _ensure ~/.claude/settings.json
    [[ -s ~/.claude/settings.json ]] || echo '{}' > ~/.claude/settings.json

    local tmp=$(mktemp)
    jq -s '.[0] * .[1]' ~/.claude/settings.json "$DIR/agents/claude/settings.json" > "$tmp"
    mv "$tmp" ~/.claude/settings.json
    chmod 600 ~/.claude/settings.json

    _status merged "$DIR/agents/claude/settings.json → $HOME/.claude/settings.json"
}

# _merge_orca_settings
# Merges orca/settings.json into Orca's profile db and updates its content_hash.
_merge_orca_settings() {
    local db="$HOME/Library/Application Support/orca/profiles/local-default/profile-state.db"

    if [[ ! -f "$db" ]]; then
        _status skipped "orca settings: $db not found"
        return 0
    fi

    _require sqlite3

    if [[ "${TERM_PROGRAM:-}" == Orca ]]; then
        _status skipped "orca settings: run from a terminal outside Orca"
        return 0
    fi

    if pgrep -x Orca >/dev/null; then
        _status skipped "orca settings: quit Orca and rerun"
        return 0
    fi

    # RFC 7396 merge patch: nested objects merge, null deletes a key.
    local new="json_patch(payload, json(readfile('$DIR/orca/settings.json')))" payload hash
    payload=$(sqlite3 "$db" "SELECT $new FROM profile_state_documents WHERE domain='settings'")
    hash=$(print -rn -- "$payload" | shasum -a 256 | cut -d' ' -f1)
    sqlite3 "$db" "UPDATE profile_state_documents SET payload = $new, content_hash = '$hash' WHERE domain='settings'"

    _status merged "orca settings → $db"
}

# _link_agents
# Symlinks agent skills, personas, and global instructions into all supported AI tool directories.
_link_agents() {
    _ensure ~/.claude/
    local claude
    for claude in "$DIR/agents/claude"/*(N); do
        [[ "${claude:t}" == "settings.json" ]] && continue
        _symlink "$claude" ~/.claude
    done
    _merge_claude_settings

    local persona
    _ensure ~/.claude/agents/
    _ensure ~/.gemini/agents/
    _ensure ~/.config/opencode/agents/
    _ensure ~/.pi/agent/prompts/

    for persona in "$DIR/agents/personas"/*.md(N); do
        _symlink "$persona" ~/.claude/agents
        _symlink "$persona" ~/.gemini/agents
        _symlink "$persona" ~/.config/opencode/agents
        _symlink "$persona" ~/.pi/agent/prompts
    done

    local skill
    _ensure ~/.claude/skills/
    _ensure ~/.agents/skills/

    for skill in "$DIR/agents/skills"/*(/N); do
        _symlink "$skill" ~/.claude/skills
        _symlink "$skill" ~/.agents/skills
    done

    # global instructions, shared across every tool.
    _ensure ~/.codex/
    _symlink "$DIR/agents/AGENTS.md" ~/.claude/AGENTS.md
    _symlink "$DIR/agents/AGENTS.md" ~/.gemini/GEMINI.md
    _symlink "$DIR/agents/AGENTS.md" ~/.codex/AGENTS.md
    _symlink "$DIR/agents/AGENTS.md" ~/.pi/agent/AGENTS.md
}

# _clean
# Removes stale dotfile and agent symlinks from home directories.
_clean() {
    _log "Cleaning stale dotfile symlinks"
    _clean_dir "$DIR/" ~ ~/.config/fish ~/.config/fish/completions ~/.config/ghostty ~/.config/git ~/.config/zed ~/.gnupg ~/.local/share/bash-completion/completions ~/.orca ~/.ssh ~/.vim ~/.zsh/completions

    _log "Cleaning stale agent dotfile symlinks"
    _clean_dir "$DIR/agents/" ~/.claude ~/.claude/skills ~/.agents/skills ~/.claude/agents ~/.gemini ~/.gemini/agents ~/.config/opencode/agents ~/.pi/agent ~/.pi/agent/prompts ~/.codex
}

# _usage
# Prints usage information to stdout.
_usage() {
    local getpath=$(_resolve_getpath)

    echo "Usage: dot [COMMAND]
Commands:
  help              prints this dialog
  init              clones dotfiles to GETPATH (~/src) and symlinks dot to ~/.local/bin
  install           installs all packages
  install-defaults  installs macos defaults
  install-brew      installs homebrew packages
  install-fisher    installs fisher packages
  install-vim       installs vim packages
  link              symlinks dotfiles and removes stale symlinks
  update            updates the dotfiles repository
  version           prints the current commit sha
"
}

# _version
# Prints the current commit SHA of the dotfiles repository.
_version() {
    _require git

    git -C "$DIR" rev-parse --short HEAD
}

# _init
# Clones the dotfiles repository to GETPATH and symlinks dot to ~/.local/bin.
_init() {
    _require git

    local getpath=$(_resolve_getpath)
    local absolute_getpath="${getpath/#\~/$HOME}"
    local target="${absolute_getpath%/}/github.com/arbourd/dotfiles"

    _log "Initializing dotfiles to $target"

    if [ -d "$target" ]; then
        _status ok "$target already exists, pulling"
        git -C "$target" pull
    else
        _ensure "${target:h}/"
        git clone https://github.com/arbourd/dotfiles.git "$target"
    fi

    _log "Symlinking dot to $HOME/.local/bin/dot"
    _ensure ~/.local/bin/
    _symlink "$target/dot" ~/.local/bin/dot
}

# _update
# Pulls the latest dotfiles changes and reports the old and new commit SHA.
_update() {
    _require git

    local before after repo
    before=$(git -C "$DIR" rev-parse --short HEAD)
    git -C "$DIR" pull --quiet
    after=$(git -C "$DIR" rev-parse --short HEAD)
    repo=$(_repo_url)

    if [ "$before" = "$after" ]; then
        _hyperlink "${repo:+$repo/commit/$after}" "$after"
        _status ok "dotfiles $REPLY (up to date)"
    else
        _hyperlink "${repo:+$repo/compare/$before...$after}" "$before → $after"
        _status updated "dotfiles $REPLY"
    fi
}

# _link
# Symlinks all dotfiles into home and removes stale symlinks.
_link() {
    _log "Symlinking dotfiles"

    # bash, fish and zsh
    _ensure ~/.config/fish/private.fish
    _symlink "$DIR/sh/.shrc" ~/.bash_profile
    _symlink "$DIR/sh/.shrc" ~/.bashrc
    _symlink "$DIR/sh/.shrc" ~/.zshrc
    _symlink "$DIR/sh/config.fish" ~/.config/fish/config.fish
    _symlink "$DIR/sh/fish_plugins" ~/.config/fish/fish_plugins

    # completions
    _ensure ~/.config/fish/completions/
    _symlink "$DIR/sh/completions/dot.fish" ~/.config/fish/completions/dot.fish
    _ensure ~/.local/share/bash-completion/completions/
    _symlink "$DIR/sh/completions/dot.bash" ~/.local/share/bash-completion/completions/dot
    _ensure ~/.zsh/completions/
    _symlink "$DIR/sh/completions/_dot" ~/.zsh/completions/_dot

    # ghostty
    _ensure ~/.config/ghostty/
    _symlink "$DIR/ghostty/config" ~/.config/ghostty/config

    # git
    _ensure ~/.config/git/private
    _symlink "$DIR/git/config" ~/.config/git/config
    _symlink "$DIR/git/gitignore" ~/.config/git/gitignore

    # gpg
    _ensure ~/.gnupg/ 700
    _symlink "$DIR/gpg/gpg-agent.conf" ~/.gnupg/gpg-agent.conf

    # orca
    _ensure ~/.orca/
    _symlink "$DIR/orca/keybindings.json" ~/.orca/keybindings.json
    _merge_orca_settings

    # ssh
    _ensure ~/.ssh/
    _symlink "$DIR/ssh/config" ~/.ssh/config

    # vim
    _ensure ~/.vim/
    _symlink "$DIR/vim/vimrc" ~/.vim/vimrc

    # zed
    _ensure ~/.config/zed/
    _symlink "$DIR/zed/settings.json" ~/.config/zed/settings.json

    _log "Symlinking agent dotfiles"
    _link_agents

    _clean
}

# _install_defaults
# Applies macOS defaults settings.
_install_defaults() {
    _log "Setting macOS defaults"
    "$DIR/.macOS"
}

# _install_brew
# Installs Homebrew if missing and installs packages from the Brewfile.
_install_brew() {
    _require curl

    if ! command -v brew &> /dev/null ; then
        _log "Installing Homebrew"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    _log "Installing Homebrew packages"
    HOMEBREW_BUNDLE_NO_LOCK=1 brew bundle --file "$DIR/Brewfile"
}

# _install_fisher
# Installs Fisher and updates all fish plugins.
_install_fisher() {
    _require brew
    _require curl
    _require git

    if ! command -v fish &> /dev/null ; then
        _log "Installing fish"
        brew install fish
    fi

    _log "Updating and installing fisher plugins"
    _ensure ~/.config/fish/functions/
    fish -c "curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher"
    fish -c "git -C \"$DIR\" checkout sh/fish_plugins && fisher update"
}

# _install_vim
# Installs vim-plug and updates all Vim plugins.
_install_vim() {
    _require vim
    _require curl

    _log "Updating vim-plug"
    _ensure ~/.vim/autoload/
    curl -fsSLo ~/.vim/autoload/plug.vim --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

    _log "Updating Vim plugins"
    # pipe two newlines to dismiss vim-plug prompts without a tty
    _spin "vim plugins" zsh -c 'echo | echo | vim +PlugUpdate +PlugClean! +qall &>/dev/null'
}

# _install
# Runs all install steps in order: brew, defaults, fisher, and vim.
_install() {
    _install_brew
    _install_defaults
    _install_fisher
    _install_vim
}

# Only dispatch when executed. ZSH_EVAL_CONTEXT contains ":file" when sourced,
# which lets tests source this file to reach the functions above.
[[ "$ZSH_EVAL_CONTEXT" == *:file* ]] && return 0

case ${1:-} in
    help)
        _usage
        exit 0
        ;;
    init)
        _init
        ;;
    link)
        _link
        ;;
    install)
        _install
        ;;
    install-brew)
        _install_brew
        ;;
    install-defaults)
        _install_defaults
        ;;
    install-fisher)
        _install_fisher
        ;;
    install-vim)
        _install_vim
        ;;
    update)
        _update
        ;;
    version)
        _version
        ;;
    "")
        _err "error: command required"
        _usage >&2
        exit 1
        ;;
    *)
        _err "error: unknown command: \"$1\""
        _usage >&2
        exit 1
        ;;
esac
