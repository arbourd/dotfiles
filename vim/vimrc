" vim-plug init
call plug#begin('~/.vim/plugged')

Plug 'lifepillar/vim-solarized8'
Plug 'mg979/vim-visual-multi', {'branch': 'master'}
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'

call plug#end()

" Use the Solarized Dark theme (silent: plugin is absent until PlugInstall runs)
set background=dark
silent! colorscheme solarized8
" Use a POSIX shell so shell commands work correctly (login shell is fish)
set shell=/bin/zsh
" Respect modeline in files
set modeline
set modelines=4
" Enable line numbers
set number
" Enable syntax highlighting
syntax on
" Highlight current line
set cursorline
" Make tabs as wide as two spaces
set tabstop=2
" Indent by the tab width
set shiftwidth=0
" Switch buffers without saving
set hidden
" Persist undo history across sessions
set undofile
set undodir=~/.vim/undo//
if !isdirectory(expand('~/.vim/undo'))
  call mkdir(expand('~/.vim/undo'), 'p', 0700)
endif
" Share the macOS clipboard
set clipboard=unnamed
" Keep context lines around the cursor
set scrolloff=5
" Case-sensitive search when the pattern has capitals
set smartcase
" Faster cursor-hold events
set updatetime=300
" Show “invisible” characters
set lcs=tab:▸\ ,trail:·,eol:¬,nbsp:_
set list
" Highlight searches
set hlsearch
" Ignore case of searches
set ignorecase
" Highlight dynamically as pattern is typed
set incsearch
" Always show status line
set laststatus=2
" Enable mouse in all modes
set mouse=a
" Disable error bells
set noerrorbells
" Don’t reset cursor to start of line when moving around.
set nostartofline
" Show the cursor position
set ruler
" Don’t show the intro message when starting Vim
set shortmess=atI
" Show the current mode
set showmode
" Show the filename in the window titlebar
set title
" Show the (partial) command as it’s being typed
set showcmd
" Allow Airline to access powerline fonts
let g:airline_powerline_fonts = 1
" Map opt+delete
inoremap <M-BS> <C-w>
" Terminals that send opt+backspace as ESC DEL (no Ghostty keybind)
inoremap <Esc><Char-127> <C-w>
inoremap <Esc><C-h> <C-w>
" opt+left/right: word motion (ESC b/f, or modified-arrow sequences)
inoremap <Esc>b <C-Left>
inoremap <Esc>f <C-Right>
inoremap <Esc>[1;3D <C-Left>
inoremap <Esc>[1;3C <C-Right>
" cmd+left/right: line start/end (Ctrl-A/E, or Home/End sequences)
inoremap <C-a> <Home>
inoremap <C-e> <End>
inoremap <Esc>[1~ <Home>
inoremap <Esc>[4~ <End>
" Keep <Esc> snappy despite the ESC-prefixed mappings above
set timeoutlen=300 ttimeout ttimeoutlen=50

" Make bg transparent (inherit parent)
hi Normal ctermbg=none
highlight NonText ctermbg=none
