#compdef dot

_dot() {
    local context state state_descr line
    typeset -A opt_args

    local -a commands=(
        'help:Print usage information'
        'init:Clone dotfiles and symlink dot to ~/.local/bin'
        'link:Symlink dotfiles and remove stale symlinks'
        'merge:Merge settings into Claude, Codex and Orca'
        'install:Install all packages'
        'update:Update the dotfiles repository'
        'version:Print the current commit SHA'
    )

    _arguments '1: :->cmd' '2: :->target'

    case $state in
        cmd) _describe 'command' commands ;;
        target)
            case $line[1] in
                merge) _values 'target' 'claude[Merge Claude settings]' 'codex[Merge Codex config]' 'orca[Merge Orca settings]' ;;
                install) _values 'target' 'brew[Install Homebrew packages]' 'defaults[Install macOS defaults]' 'fisher[Install Fisher packages]' 'vim[Install Vim packages]' ;;
            esac
            ;;
    esac
}

_dot "$@"
