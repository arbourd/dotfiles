  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline.sh",
    "refreshInterval": 5000
  },
  "theme": "dark"
}
