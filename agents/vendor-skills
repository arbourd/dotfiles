#!/usr/bin/env nu
# Copies the SKILL.md files listed in skills.json into skills/.
#
#   vendor-skills [name...]    all skills, or just the named ones
#
# Sources use github.com/<owner>/<repo>/<path>@<commit>.
# If you omit the commit, the script records the repository's current HEAD commit.
# Renovate updates the commits. Do not edit these copies by hand. The script overwrites them.
const DIR = path self | path dirname

def main [...names: string] {
    let manifest_path = $DIR | path join skills.json
    mut manifest = open $manifest_path
    let names = if ($names | is-empty) { $manifest.skills | columns | sort } else { $names }
    if ($names | is-empty) { return }
    let width = $names | str length | math max

    for name in $names {
        let source = $manifest.skills | get -o $name | get -o source
        if $source == null {
            error make {msg: $"unknown skill: ($name)"}
        }
        let source_parts = $source | parse --regex '^github\.com/(?<repo>[^/]+/[^/]+)/(?<file>[^@]+)(?:@(?<commit>.+))?$' | get -o 0
        if $source_parts == null {
            error make {msg: $"unsupported host: ($source)"}
        }
        let pinned = $source_parts.commit == null
        let commit = if $pinned {
            let sha = ^gh api $"repos/($source_parts.repo)/commits/HEAD" --jq .sha | str trim --right --char "\n"
            let key = ['skills' $name 'source'] | into cell-path
            $manifest = $manifest | update $key $"($source)@($sha)"
            $"($manifest | to json --indent 2)\n" | save --raw --force $"($manifest_path).tmp"
            mv --force $"($manifest_path).tmp" $manifest_path
            $sha
        } else { $source_parts.commit }

        let content = ^gh api $"repos/($source_parts.repo)/contents/($source_parts.file)?ref=($commit)" -H 'Accept: application/vnd.github.raw' | str trim --right --char "\n"
        let dest = $DIR | path join skills $name SKILL.md
        let state = if $pinned {
            'pinned'
        } else if ($dest | path exists) and ((open --raw $dest | str trim --right --char "\n") == $content) {
            'unchanged'
        } else { 'changed' }
        mkdir ($dest | path dirname)
        # One trailing newline, so files compare equal to upstream.
        $"($content)\n" | save --raw --force $dest
        print $"($name | fill --width $width)  ($commit | str substring 0..6)  ($state)"
    }
}
