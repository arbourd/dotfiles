{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigestsToSemver"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "enabledManagers": ["custom.regex", "github-actions", "gomod"],
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["dot"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["internal/install/pins.go"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nconst \\w+ = \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["sh/fish_plugins"],
      "matchStrings": ["jorgebucaran/fisher@(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "jorgebucaran/fisher"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/skills.json"],
      "matchStrings": [
        "\"source\": \"github\\.com/(?<depName>[^/\"]+/[^/\"]+)/[^@\"]+@(?<currentDigest>[0-9a-f]{40})\",\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/skills.json"],
      "matchStrings": [
        "\"source\": \"github\\.com/(?<depName>[^/\"]+/[^/\"]+)/[^@\"]+@(?<currentDigest>[0-9a-f]{40})\"\\s*\\}"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Homebrew install script pinned to a commit",
      "managerFilePatterns": ["dot", "internal/install/pins.go"],
      "matchStrings": ["Homebrew/install/(?<currentDigest>[0-9a-f]{40})/install\\.sh"],
      "depNameTemplate": "Homebrew/install",
      "packageNameTemplate": "https://github.com/Homebrew/install",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/claude/settings.jsonc"],
      "matchStrings": ["\"repo\": \"(?<depName>[^\"]+)\",\\s*\"ref\": \"(?<currentValue>[^\".]+\\.[^\"]+)\""],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Claude marketplaces without releases, pinned to a commit",
      "managerFilePatterns": ["agents/claude/settings.jsonc"],
      "matchStrings": ["\"repo\": \"(?<depName>[^\"]+)\",\\s*\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/codex/config.toml"],
      "matchStrings": ["source = \"https://github\\.com/(?<depName>[^\"]+)\\.git\"\\s*ref = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Homebrew/install moves several times a week, so bump it monthly",
      "matchDepNames": ["Homebrew/install"],
      "schedule": ["* * 1 * *"],
      "updateNotScheduled": false
    },
    {
      "matchFileNames": ["agents/claude/settings.jsonc", "agents/codex/config.toml"],
      "description": "git-refs SHA pins have no release timestamp, so don't let the age gate block them",
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false,
      "groupName": "agent plugins"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["gomod"],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["agents/skills.json"],
      "groupName": "vendored skills",
      "automerge": false
    },
    {
      "description": "Update skills by version only, not digest",
      "matchFileNames": ["agents/skills.json"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ],
  "platformAutomerge": false
}
