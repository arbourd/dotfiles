{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigestsToSemver"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["dot"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["sh/fish_plugins"],
      "matchStrings": ["jorgebucaran/fisher@(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "jorgebucaran/fisher"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/skills.json"],
      "matchStrings": [
        "\"source\": \"github\\.com/(?<depName>[^/\"]+/[^/\"]+)/[^@\"]+@(?<currentDigest>[0-9a-f]{40})\",\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["agents/skills.json"],
      "matchStrings": [
        "\"source\": \"github\\.com/(?<depName>[^/\"]+/[^/\"]+)/[^@\"]+@(?<currentDigest>[0-9a-f]{40})\"\\s*\\}"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Homebrew install script pinned to a commit",
      "managerFilePatterns": ["dot"],
      "matchStrings": ["Homebrew/install/(?<currentDigest>[0-9a-f]{40})/install\\.sh"],
      "depNameTemplate": "Homebrew/install",
      "packageNameTemplate": "https://github.com/Homebrew/install",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Homebrew/install moves several times a week, so bump it monthly",
      "matchDepNames": ["Homebrew/install"],
      "schedule": ["* * 1 * *"],
      "updateNotScheduled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["agents/skills.json"],
      "groupName": "vendored skills",
      "automerge": false
    }
  ],
  "platformAutomerge": false
}
