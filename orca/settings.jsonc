{
  // null deletes the key, resetting it to Orca's default ({}).
  "agentDefaultArgs": null,
  "agentDefaultEnv": null,
  // Default: "full-access".
  "agentPermissionDefault": "auto",
  // Default: null.
  "defaultTuiAgent": "blank",
  // null deletes the key, resetting it to Orca's default (false).
  "experimentalNativeChat": null,
  // Default: true, "floating-button".
  "floatingTerminalEnabled": false,
  "floatingTerminalTriggerLocation": "status-bar",
  // Default: true.
  "mobileEmulatorEnabled": false,
  // Default: "automatic".
  "mobilePairingConnectionMode": "local-only",
  // Default: "full-access".
  "nativeChatPermissionMode": "auto",
  "notifications": {
    // Default: false.
    "terminalBell": true
  },
  // Default: VS Code.
  "openInApplications": [
    {
      "id": "zed",
      "label": "Zed",
      "command": "zed"
    }
  ],
  // Default: true.
  "primarySelectionMiddleClickPaste": false,
  // Default: true.
  "showMobileButton": false,
  // Default: true.
  "showMenuBarIcon": false,
  // Default: "list".
  "sourceControlViewMode": "tree",
  // Solarized Dark; not set by default.
  "terminalColorOverrides": {
    "black": "#073642",
    "red": "#dc322f",
    "green": "#859900",
    "yellow": "#b58900",
    "blue": "#268bd2",
    "magenta": "#d33682",
    "cyan": "#2aa198",
    "white": "#eee8d5",
    "brightBlack": "#335e69",
    "brightRed": "#cb4b16",
    "brightGreen": "#586e75",
    "brightYellow": "#657b83",
    "brightBlue": "#839496",
    "brightMagenta": "#6c71c4",
    "brightCyan": "#93a1a1",
    "brightWhite": "#fdf6e3",
    "background": "#002b36",
    "foreground": "#839496",
    "cursor": "#839496",
    "cursorAccent": "#073642",
    "selectionBackground": "#073642",
    "selectionForeground": "#93a1a1"
  },
  // Default: "block".
  "terminalCursorStyle": "underline",
  // Default: "" (system shell).
  "terminalDefaultShell": "/opt/homebrew/bin/fish",
  // Default: "SF Mono".
  "terminalFontFamily": "Source Code Pro for Powerline",
  // Default: true.
  "terminalScopeHistoryByWorktree": false,
  // Default: "Ghostty Default Style Dark".
  "terminalThemeDark": "Solarized Dark",
  // Default: "system".
  "theme": "dark",
  "worktreeVisibilityDefaults": {
    // Not set by default.
    "sourcePreferences": {
      "builtIn": {
        "claude": "show"
      }
    }
  }
}
