{
  // Default: {}.
  "agentDefaultArgs": {
    "antigravity": "--mode auto",
    "claude": "--permission-mode auto",
    "codex": "--approve-for-me"
  },
  // Default: "full-access".
  "agentPermissionDefault": "auto",
  // null deletes the key; Orca seeds "own" for agents without an override.
  "agentPermissionOverrides": {
    "codex": "auto",
    "codebuddy": null,
    "openclaude": null,
    "autohand": null,
    "ante": null,
    "trae": null,
    "opencode": null,
    "opencode2": null,
    "omp": null,
    "qoder": null,
    "qoder-cn": null,
    "gemini": null,
    "antigravity": null,
    "aider": null,
    "goose": null,
    "amp": null,
    "kiro": null,
    "crush": null,
    "cline": null,
    "command-code": null,
    "continue": null,
    "cursor": null,
    "droid": null,
    "kimi": null,
    "mistral-vibe": null,
    "qwen-code": null,
    "rovo": null,
    "hermes": null,
    "copilot": null,
    "grok": null,
    "muse": null,
    "zcode": null,
    "devin": null
  },
  // Default: unset.
  "aiVaultSearch": {
    "enabled": true
  },
  // Default: true.
  "artifactSharingEnabled": false,
  // Default: unset.
  "browserPasswordsOfferToSave": false,
  // Default: false.
  "combinedDiffFileTreeVisibleByDefault": true,
  // Default: null.
  "defaultTuiAgent": "blank",
  // Default: [].
  "disabledTuiAgents": ["claude-agent-teams"],
  // Default: unset.
  "experimentalAgentDashboardPopout": true,
  // Default: unset.
  "experimentalNativeChat": false,
  // Default: false.
  "experimentalNewWorktreeCardStyle": true,
  // Default: false.
  "experimentalTerminalAttention": true,
  // Default: true, "floating-button".
  "floatingTerminalEnabled": false,
  "floatingTerminalTriggerLocation": "status-bar",
  // Default: true.
  "mobileEmulatorEnabled": false,
  // Default: "automatic".
  "mobilePairingConnectionMode": "local-only",
  // Default: "full-access".
  "nativeChatPermissionMode": "auto",
  // Default: true.
  "nativeChatResumeWorkOnRestart": false,
  // Default: unset.
  "newWorkspaceSetupOnly": false,
  "notifications": {
    // Default: false.
    "terminalBell": true
  },
  // Default: VS Code.
  "openInApplications": [
    {
      "id": "zed",
      "label": "Zed",
      "command": "zed"
    }
  ],
  // Default: unset.
  "orchestrationChatErrorEscalationEnabled": true,
  // Default: true.
  "primarySelectionMiddleClickPaste": false,
  // Default: true.
  "showMobileButton": false,
  // Default: true.
  "showMenuBarIcon": false,
  // Default: "list".
  "sourceControlViewMode": "tree",
  // Default: unset. Solarized Dark.
  "terminalColorOverrides": {
    "black": "#073642",
    "red": "#dc322f",
    "green": "#859900",
    "yellow": "#b58900",
    "blue": "#268bd2",
    "magenta": "#d33682",
    "cyan": "#2aa198",
    "white": "#eee8d5",
    "brightBlack": "#335e69",
    "brightRed": "#cb4b16",
    "brightGreen": "#586e75",
    "brightYellow": "#657b83",
    "brightBlue": "#839496",
    "brightMagenta": "#6c71c4",
    "brightCyan": "#93a1a1",
    "brightWhite": "#fdf6e3",
    "background": "#002b36",
    "foreground": "#839496",
    "cursor": "#839496",
    "cursorAccent": "#073642",
    "selectionBackground": "#073642",
    "selectionForeground": "#93a1a1"
  },
  // Default: "block".
  "terminalCursorStyle": "underline",
  // Default: "" (system shell).
  "terminalDefaultShell": "/opt/homebrew/bin/fish",
  // Default: "SF Mono".
  "terminalFontFamily": "Source Code Pro for Powerline",
  // Default: true.
  "terminalScopeHistoryByWorktree": false,
  // Default: "Ghostty Default Style Dark".
  "terminalThemeDark": "Solarized Dark",
  // Default: "system".
  "theme": "dark",
  // Default: unset.
  "updateDelayDays": 3,
  // Default: ["github","gitlab","linear","jira"].
  "visibleTaskProviders": ["github"],
  "voice": {
    // Default: false.
    "enabled": true,
    // Default: unset.
    "language": "en",
    // Default: "".
    "sttModel": "parakeet-tdt-0.6b-v2-int8"
  },
  // Default: unset.
  "worktreeVisibilityDefaults": {
    "sourcePreferences": {
      "builtIn": {
        "claude": "show"
      }
    }
  }
}
